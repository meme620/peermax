.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# codegraph 索引：本地可重建，不入库
.codegraph/

# 数据：raw/ 二进制不入库（Release 附件分发）；processed/ 只入库目录骨架（.gitkeep），生成产物留本地
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep

# 审计工作记录：不入库
artifacts/

# 运行记录与冒烟产物：不入库（index.json、tables/、summary.md 入库）
result/runs/
result/smoke/

# 门禁与审计产物：由脚本运行时生成，不入库
reports/
